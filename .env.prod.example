# ─────────────────────────────────────────────────────
# .env.prod — Variables d'environnement de production
# Copier ce fichier en .env.prod et remplir les valeurs
# NE JAMAIS committer .env.prod dans git
# ─────────────────────────────────────────────────────

# URL publique complète (schéma + domaine ou IP), utilisée pour les liens
# générés par le backend (fiches techniques dans les PDF, CORS, etc.)
# Exemples : http://72.62.188.28  ou  https://rhs.mondomaine.com
PUBLIC_URL=http://votre-ip-ou-domaine

# PostgreSQL
POSTGRES_PASSWORD=mot_de_passe_long_et_securise

# JWT — Générer avec : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=remplacer_par_une_cle_de_128_caracteres_hex
JWT_EXPIRES_IN=7d
